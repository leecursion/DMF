{
  "@context": {
    "@version": 1.1,
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "cmis": "http://docs.oasis-open.org/ns/cmis/core/200908/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dmf": "urn:dmf:ns:",

    "id": "@id",
    "type": "@type",

    "Entity": "prov:Entity",
    "Activity": "prov:Activity",
    "Agent": "prov:Agent",
    "Person": "prov:Person",
    "SoftwareAgent": "prov:SoftwareAgent",
    "Organization": "prov:Organization",
    "Plan": "prov:Plan",
    "Collection": "prov:Collection",
    "Bundle": "prov:Bundle",

    "Document":           "dmf:Document",
    "DocumentVersion":    "dmf:DocumentVersion",
    "Module":             "dmf:Module",
    "ModuleRevision":     "dmf:ModuleRevision",
    "Ticket":             "dmf:Ticket",
    "Decision":           "dmf:Decision",
    "Approval":           "dmf:Approval",
    "VerificationReport": "dmf:VerificationReport",
    "Release":            "dmf:Release",
    "ApprovalPolicy":     "dmf:ApprovalPolicy",
    "RestrictPolicy":     "dmf:RestrictPolicy",
    "GatePolicy":         "dmf:GatePolicy",
    "AcceptanceCriteria": "dmf:AcceptanceCriteria",
    "AuditEvent":         "dmf:AuditEvent",

    "EditActivity":       "dmf:EditActivity",
    "DecomposeActivity":  "dmf:DecomposeActivity",
    "MergeActivity":      "dmf:MergeActivity",
    "RestrictCheck":      "dmf:RestrictCheckActivity",
    "VerifyActivity":     "dmf:VerifyActivity",
    "ApproveActivity":    "dmf:ApproveActivity",
    "ShadowDeploy":       "dmf:ShadowDeployActivity",
    "PromoteActivity":    "dmf:PromoteActivity",
    "RollbackActivity":   "dmf:RollbackActivity",

    "wasGeneratedBy":     { "@id": "prov:wasGeneratedBy",     "@type": "@id" },
    "used":               { "@id": "prov:used",               "@type": "@id", "@container": "@set" },
    "wasAssociatedWith":  { "@id": "prov:wasAssociatedWith",  "@type": "@id" },
    "wasAttributedTo":    { "@id": "prov:wasAttributedTo",    "@type": "@id" },
    "wasDerivedFrom":     { "@id": "prov:wasDerivedFrom",     "@type": "@id", "@container": "@set" },
    "wasRevisionOf":      { "@id": "prov:wasRevisionOf",      "@type": "@id" },
    "specializationOf":   { "@id": "prov:specializationOf",   "@type": "@id" },
    "alternateOf":        { "@id": "prov:alternateOf",        "@type": "@id" },
    "wasInformedBy":      { "@id": "prov:wasInformedBy",      "@type": "@id" },
    "actedOnBehalfOf":    { "@id": "prov:actedOnBehalfOf",    "@type": "@id" },
    "hadMember":          { "@id": "prov:hadMember",          "@type": "@id", "@container": "@list" },
    "invalidatedAtTime":  { "@id": "prov:invalidatedAtTime",  "@type": "xsd:dateTime" },
    "startedAtTime":      { "@id": "prov:startedAtTime",      "@type": "xsd:dateTime" },
    "endedAtTime":        { "@id": "prov:endedAtTime",        "@type": "xsd:dateTime" },
    "generatedAtTime":    { "@id": "prov:generatedAtTime",    "@type": "xsd:dateTime" },
    "qualifiedAssociation": { "@id": "prov:qualifiedAssociation", "@container": "@set" },
    "qualifiedUsage":     { "@id": "prov:qualifiedUsage",     "@container": "@set" },
    "agent":              { "@id": "prov:agent",              "@type": "@id" },
    "entity":             { "@id": "prov:entity",             "@type": "@id" },
    "hadRole":            { "@id": "prov:hadRole",            "@type": "@vocab" },
    "hadPlan":            { "@id": "prov:hadPlan",            "@type": "@id" },

    "title":       "dcterms:title",
    "creator":     { "@id": "dcterms:creator",     "@type": "@id" },
    "created":     { "@id": "dcterms:created",     "@type": "xsd:dateTime" },
    "modified":    { "@id": "dcterms:modified",    "@type": "xsd:dateTime" },
    "identifier":  "dcterms:identifier",
    "format":      "dcterms:format",
    "subject":     "dcterms:subject",
    "isVersionOf": { "@id": "dcterms:isVersionOf", "@type": "@id" },
    "replaces":    { "@id": "dcterms:replaces",    "@type": "@id" },
    "hasPart":     { "@id": "dcterms:hasPart",     "@type": "@id" },
    "isPartOf":    { "@id": "dcterms:isPartOf",    "@type": "@id" },
    "conformsTo":  { "@id": "dcterms:conformsTo",  "@type": "@id" },
    "accessRights": "dcterms:accessRights",

    "versionSeriesId":  "cmis:versionSeriesId",
    "versionLabel":     "cmis:versionLabel",
    "isLatestVersion":  { "@id": "cmis:isLatestVersion", "@type": "xsd:boolean" },
    "changeToken":      "cmis:changeToken",
    "checkinComment":   "cmis:checkinComment",
    "contentStreamId":  "cmis:contentStreamId",
    "contentStreamMimeType": "cmis:contentStreamMimeType",
    "policyIds":        { "@id": "cmis:policyIds", "@type": "@id", "@container": "@set" },

    "ticketKey":        "dmf:ticketKey",
    "ticketKind":       { "@id": "dmf:ticketKind",   "@type": "@vocab" },
    "status":           { "@id": "dmf:status",       "@type": "@vocab" },
    "riskLevel":        { "@id": "dmf:riskLevel",    "@type": "xsd:integer" },
    "targetModule":     { "@id": "dmf:targetModule", "@type": "@id", "@container": "@set" },
    "mutability":       { "@id": "dmf:mutability",   "@type": "@vocab" },
    "ordinal":          { "@id": "dmf:ordinal",      "@type": "xsd:integer" },
    "dependsOn":        { "@id": "dmf:dependsOn",    "@type": "@id", "@container": "@set" },
    "contentSha256":    "dmf:contentSha256",
    "manifestRoot":     "dmf:manifestRoot",
    "restrictSeal":     "dmf:restrictSeal",
    "versionHash":      "dmf:versionHash",
    "parentVersionHash": "dmf:parentVersionHash",
    "outcome":          { "@id": "dmf:outcome",      "@type": "@vocab" },
    "verdict":          { "@id": "dmf:verdict",      "@type": "@vocab" },
    "channel":          { "@id": "dmf:channel",      "@type": "@vocab" },
    "subjectManifestRoot": "dmf:subjectManifestRoot",
    "policySha256":     "dmf:policySha256",
    "auditChain":       "dmf:auditChain",
    "auditSeq":         { "@id": "dmf:auditSeq",     "@type": "xsd:integer" },
    "entryHash":        "dmf:entryHash",
    "prevHash":         "dmf:prevHash"
  }
}
